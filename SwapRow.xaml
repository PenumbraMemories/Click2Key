<UserControl x:Class="Click2Key.Controls.SwapRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="17,13,20,13" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
      <Button x:Name="FirstButton" Background="{DynamicResource KeycapBrush}" Foreground="{DynamicResource KeyInkBrush}" FontSize="16" FontWeight="Bold" Click="Capture_Click" PreviewKeyDown="Capture_KeyDown" LostKeyboardFocus="Capture_LostFocus"/>
      <TextBlock Grid.Column="1" Text="⇄" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource PinkAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="SecondButton" Grid.Column="2" Background="{DynamicResource PinkKeycapBrush}" Foreground="{DynamicResource PinkInkBrush}" FontSize="16" FontWeight="Bold" Click="Capture_Click" PreviewKeyDown="Capture_KeyDown" LostKeyboardFocus="Capture_LostFocus"/>
      <CheckBox x:Name="EnabledToggle" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Checked="Changed" Unchecked="Changed" ToolTip="启用互换"/>
      <Button Grid.Column="4" Content="×" Width="34" Height="34" Padding="0" HorizontalAlignment="Center" Background="{DynamicResource PinkKeycapBrush}" Foreground="{DynamicResource PinkInkBrush}" FontSize="19" FontWeight="Bold" Click="Remove_Click" ToolTip="删除互换"/>
    </Grid>
  </Border>
</UserControl>


